# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# junk left behind by mounted/synced folders — never real source files
.fuse_hidden*
# LibreOffice / Office leave these behind while a file is OPEN. They are not
# source, they change every time you open a PDF, and they made the 2026-08-03
# commit noisier than it needed to be.
.~lock.*#
~$*
*.tmp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets (CLAUDE.md Hard Rule 4)
.env*
# ...but the example template (placeholders only) IS committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# eval reports — may quote real-document contents once golden cases are real (PDPA)
/eval/reports/*
!/eval/reports/.gitkeep
# ...but the aggregate-only summary IS committed. It is the published accuracy
# number (evidence #5) and must exist in the repo — "gitignored means it does not
# exist" is exactly how the 93.6% from 2026-07-18 disappeared. Rule for that file:
# numbers only, never a donor name, an amount, or a line of meeting content.
!/eval/reports/SUMMARY.md

# 2026-08-18 Cowork 的一次性脚本与 build log，不要进 git
/tmp/

# ---------------------------------------------------------------------------
# 2026-08-21 (minit-v2). The old repo had 1,959 tracked files and 1,458 of them
# — 74% — were review output that nobody ever read again. `git add -A` in
# push-to-github.bat is what swept them in, and once a folder is in the history
# deleting it later does not take it back out.
#
# These are the folders that did it. They are blocked here so the new tree
# cannot repeat the old tree's mistake, whatever tool runs `git add` next.
# If you ever genuinely need one of these in git, delete its line deliberately
# and say why in the commit message.
# ---------------------------------------------------------------------------
/r1-output/
/r1c-output/
/audit-output/
/remediation-output/
/PROJECT_REPORT/
/chat-backup-*/
/_backups/
/_wtest

# Working notes an agent drops in the root. STATE.md is the ONE handover file
# (CLAUDE.md, documentation layout) — a dated one never gets overwritten, so
# they pile up and contradict each other.
/MINIT_*_20*.md
/*-HANDOFF-*.md
